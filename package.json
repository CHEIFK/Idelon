{
  "name": "idle-game-engine",
  "version": "0.1.0",
  "description": "Headless, UI-agnostic engine foundation for a multiplayer idle RPG",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/discord/botRunner.js",
"dev": "nodemon src/discord/botRunner.js",
"register": "node scripts/registerCommands.js",
"sync-emojis": "node scripts/syncEmojis.js",
    "slice-assets": "node scripts/sliceAssets.js",
    "validate-save": "node scripts/validateSave.js",
    "migrate-save": "node scripts/migrateSave.js",
    "test": "IDELON_TEST=1 node --test tests/*.test.js"
  },
  "keywords": [
    "idle-game",
    "rpg-engine",
    "headless-engine",
    "discord-bot"
  ],
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.18.0",
    "sharp": "^0.33.5"
  },
  "author": "",
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3": true,
    "sharp@0.33.5": true
  }
}
